<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Home - BookEase</title>
    <link href="reservationStyle.css" rel="stylesheet" type="text/css"/>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <header class="main-header">
        <div class="logo-container">
            <h1 class="brand-name">BookEase</h1>
        </div>
        <nav class="main-nav">
            <ul>
                <li><a href="home.jsp" class="active">Home</a></li>
                <li><a href="reservation.jsp">Reservations</a></li>
                <li><a href="price.jsp">View Prices</a></li>
                <li><a href="about.jsp">About Us</a></li>
                <li><a href="contact.jsp">Contact</a></li>
                <li><a href="profile.jsp">My Profile</a></li>
            </ul>
        </nav>
    </header>

    <div class="container">
        <header>Available Rooms</header>
        
        <div class="room-list">
            <!-- Room 1 -->
            <div class="room">
                <img src="images/room1.jpg" alt="Room 1" class="room-image">
                <div class="room-details">
                    <h2>Single Room</h2>
                    <p>Perfect for solo travelers. Comfortable and cozy.</p>
                    <p>Price: $100 per night</p>
                    <a href="reservation.jsp" class="reserve-button">Reserve</a>
                </div>
            </div>

            <!-- Room 2 -->
            <div class="room">
                <img src="images/room2.jpg" alt="Room 2" class="room-image">
                <div class="room-details">
                    <h2>Double Room</h2>
                    <p>Ideal for couples. Spacious and well-furnished.</p>
                    <p>Price: $150 per night</p>
                    <a href="reservation.jsp" class="reserve-button">Reserve</a>
                </div>
            </div>

            <!-- Room 3 -->
            <div class="room">
                <img src="images/room3.jpg" alt="Room 3" class="room-image">
                <div class="room-details">
                    <h2>Family Room</h2>
                    <p>Great for families with kids. Plenty of space.</p>
                    <p>Price: $200 per night</p>
                    <a href="reservation.jsp" class="reserve-button">Reserve</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="main-footer">
        <p>BookEase - Your one-stop hotel reservation system | &copy; 2024</p>
    </footer>
</body>
</html>
